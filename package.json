{
  "name": "expressjs-mvc-api",
  "version": "1.0.0",
  "description": "A scalable Express.js REST and GraphQL API with MVC architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"nodemon src/server.js\" \"npm run docs:watch\"",
    "docs:watch": "nodemon --watch src/docs/swagger.js --exec \"node scripts/generate-swagger.js\"",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write .",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "npm test -- --watchAll",
    "prepare": "husky install"
  },
  "keywords": [
    "express",
    "api",
    "mvc",
    "graphql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "apollo-server-express": "^3.12.0",
    "aws-sdk": "^2.1488.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "detect-port": "^2.1.0",
    "doctrine": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "graphql": "^16.8.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "pm2": "^5.4.2",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "spawn-command": "^0.0.2",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@controllers/(.*)$": "<rootDir>/src/controllers/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@models/(.*)$": "<rootDir>/src/models/$1",
      "^@middlewares/(.*)$": "<rootDir>/src/middlewares/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1"
    }
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
